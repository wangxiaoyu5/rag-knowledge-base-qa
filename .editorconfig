# EditorConfig: 统一跨编辑器的基础格式配置
# 所有主流编辑器（VS Code / PyCharm / Sublime Text）都支持

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python 文件
[*.py]
indent_size = 4

# Markdown 文件
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# YAML / YML
[*.{yml,yaml}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# JavaScript / TypeScript
[*.{js,jsx,ts,tsx}]
indent_size = 2

# Shell / Batch
[*.{sh,bat,cmd}]
indent_size = 4
end_of_line = lf

# Makefile
[Makefile]
indent_style = tab

# .env 文件保持原样
[.env*]
trim_trailing_whitespace = false
insert_final_newline = false
